{
  "openapi": "3.1.0",
  "info": {
    "title": "World Bank Debarred Firms Screening API",
    "description": "Screen a company name against the World Bank Group's list of debarred and cross-debarred firms: matching that ignores legal suffixes, accents and word order, weighs distinctive words over common ones, and checks former names and trading names; sanction basis, dates, cross-debarring bank, registration numbers, and a feed of additions and removals. Firms only.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/screen": {
      "get": {
        "summary": "Is this company on the World Bank debarment list?",
        "operationId": "screenCompany",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "Company name in Latin letters, any legal suffix, e.g. Roprucsa",
              "title": "Name"
            },
            "description": "Company name in Latin letters, any legal suffix, e.g. Roprucsa"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional ISO country code to narrow the match, e.g. PE"
          },
          {
            "name": "threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Minimum match score 0.5–1.0 (default 0.8)",
              "default": 0.8,
              "title": "Threshold"
            },
            "description": "Minimum match score 0.5–1.0 (default 0.8)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Maximum matches, 1–20",
              "default": 5,
              "title": "Limit"
            },
            "description": "Maximum matches, 1–20"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/screen/batch": {
      "post": {
        "summary": "Screen up to 50 company names in one call",
        "operationId": "screenBatch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/firms": {
      "get": {
        "summary": "Firms on the list, filtered by country, basis or dates",
        "operationId": "listFirms",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ISO country code, e.g. CN"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "debarred or cross_debarred"
          },
          {
            "name": "cross_debarment_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ADB, AFDB, EBRD or IDB"
          },
          {
            "name": "listed_since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only firms the World Bank added to its list on or after this date, YYYY-MM-DD"
          },
          {
            "name": "ineligible_from_since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only firms whose ineligibility started on or after this date, YYYY-MM-DD"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "1–100",
              "default": 50,
              "title": "Per Page"
            },
            "description": "1–100"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/firms/{firm_id}": {
      "get": {
        "summary": "One firm, with its change history",
        "operationId": "firmDetail",
        "parameters": [
          {
            "name": "firm_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Firm Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/changes": {
      "get": {
        "summary": "Firms added to, removed from or changed on the list",
        "operationId": "changesFeed",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "ISO date or datetime (UTC), e.g. 2026-09-01",
              "title": "Since"
            },
            "description": "ISO date or datetime (UTC), e.g. 2026-09-01"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "1–200",
              "default": 100,
              "title": "Per Page"
            },
            "description": "1–200"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/codes": {
      "get": {
        "summary": "What the fields mean",
        "operationId": "fieldNotes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Names",
            "description": "Up to 50 company names"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country",
            "description": "Optional ISO country code applied to every name"
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.5,
            "title": "Threshold",
            "default": 0.8
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "BatchRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://world-bank-debarred-firms-screening.p.rapidapi.com",
      "description": "RapidAPI gateway"
    }
  ]
}